# Copy to `.env` and replace every `change-me` value.
# Never commit real credentials or keys.

# --- Shared application settings -------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL (auth_db, users_db, roles_db) ------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AUTH_DB_NAME=auth_db
USERS_DB_NAME=users_db
ROLES_DB_NAME=roles_db

# --- MongoDB (audit) -------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=audit_db
MONGO_URI=mongodb://root:change-me@mongodb:27017/audit_db?authSource=admin
AUDIT_RETENTION_DAYS=90

# --- Redis (cache and token revocation) ------------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
CACHE_TTL_SECONDS=60

# --- RabbitMQ (domain events) ----------------------------------------------------
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_URL=amqp://app:change-me@rabbitmq:5672/

# --- Qdrant / OpenAI -------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# Any OpenAI-compatible provider. OpenCode Go:
# https://opencode.ai/inference/go/openai/v1 ; OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENAI_API_KEY=

# --- AI service (E5) --------------------------------------------------------------
OPENAI_MODEL=glm-5.3-flash
OPENAI_TIMEOUT_SECONDS=60
# Chat: local FastEmbed (no API key/cost) or OpenAI embeddings when a key exists.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=text-embedding-3-small
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_DIR=/models
QDRANT_COLLECTION=system_docs_fastembed_v1
RETRIEVAL_MIN_SCORE=0.2
PROMPT_VERSION=v1
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=64
TOP_K=4
MAX_ANSWER_TOKENS=1200
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_SECONDS=0.5
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
# USD per one million tokens (GLM-5.3-Flash on OpenCode Go).
CHAT_INPUT_PRICE_PER_MILLION=0.15
CHAT_OUTPUT_PRICE_PER_MILLION=0.50
EMBEDDING_INPUT_PRICE_PER_MILLION=0

# --- JWT -------------------------------------------------------------------------
JWT_ISSUER=auth-service
JWT_AUDIENCE=user-management
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Rate limiting (per client IP on /auth/login, /auth/register, /auth/refresh) --
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Service-to-service (internal network) ----------------------------------------
ROLE_SERVICE_URL=http://role-service:8000
ROLE_SERVICE_TIMEOUT_SECONDS=2

# --- Frontend build ---------------------------------------------------------------
VITE_API_URL=/api

# --- Admin bootstrap (profile `local`) --------------------------------------------
# Uncomment COMPOSE_PROFILES=local in `.env` to run the one-shot bootstrap on `up`.
# If the account already exists its password is NOT updated.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
